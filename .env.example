# Copia a .env y llena los valores. Nunca subas .env.
# Llave secreta de PEY (portal -> Desarrollador). Solo backend.
PEY_API_KEY=
# Tomada de docs.pey.mx (Referencia de la API -> Introduction -> Base URL).
PEY_API_BASE_URL=https://api.pey.mx
# Secreto con el que PEY firma los webhooks (portal PEY).
PEY_WEBHOOK_SECRET=
# CLABE propia para el spike de PEY (solo local, nunca se sube).
PEY_TEST_CLABE=
# Llave de OpenAI (creditos del hackathon). Solo backend.
OPENAI_API_KEY=
# Modelo de OpenAI a usar (se confirma en el spike HND-017).
OPENAI_MODEL=
# Postgres. En Render lo llena el Blueprint; en local, tu propia base.
DATABASE_URL=
# Cadena larga y aleatoria para firmar sesiones (openssl rand -hex 32).
SESSION_SECRET=
# URL publica de la app (Render), para recibir webhooks.
APP_URL=
